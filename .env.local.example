# 이 파일을 .env.local로 복사해서 쓴다.
# .env.local은 .gitignore의 `.env*` 규칙에 걸려서 깃에 올라가지 않음.

# 어떤 분류기를 쓸지. 비워두면 ANTHROPIC_API_KEY 유무로 자동 선택.
#   ollama    - 로컬 모델. 무료, 무제한, 오프라인.
#   anthropic - Claude API. 유료(크레딧 필요).
CLASSIFIER_PROVIDER=ollama

# --- ollama 쓸 때 ---
# 기본값이 아래와 같아서, 그대로 쓸 거면 안 적어도 된다.
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_HOST=http://127.0.0.1:11434

# --- anthropic 쓸 때 ---
# 키 발급: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-여기에키
# ANTHROPIC_MODEL=claude-haiku-4-5
