# 이 파일을 .env.local로 복사해서 쓴다.
# .env.local은 .gitignore의 `.env*` 규칙에 걸려서 깃에 올라가지 않음.
#
# 아무것도 설정하지 않아도 앱은 뜬다. 예시 입력에 한해 미리 계산해둔
# 결과(데모 모드)가 나오고, 그 사실이 화면에 표시된다.

# 어떤 분류기를 쓸지. 비워두면 키가 있는 쪽을 자동으로 고른다.
#   ollama    - 내 컴퓨터의 로컬 모델. 무료, 무제한. 배포 환경에서는 못 씀.
#   gemini    - Google 무료 티어. 신용카드 없이 키 발급 가능. 배포용.
#   anthropic - Claude. 품질은 가장 좋지만 크레딧이 필요.
CLASSIFIER_PROVIDER=ollama

# --- ollama (로컬 개발) ---
# 기본값이 아래와 같아서 그대로 쓸 거면 안 적어도 된다.
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_HOST=http://127.0.0.1:11434
# 모델을 GPU에 붙잡아두는 시간. 짧으면 호출마다 5.6GB를 다시 올린다.
# OLLAMA_KEEP_ALIVE=30m

# --- gemini (Vercel 배포용) ---
# 키 발급: https://aistudio.google.com/apikey  (카드 등록 불필요)
# 무료 티어는 Flash 계열만 쓸 수 있고 분당 요청 수에 제한이 있다.
# 모델 이름이 바뀌면 GEMINI_MODEL로 덮어쓴다.
# GEMINI_API_KEY=여기에키
# GEMINI_MODEL=gemini-3.5-flash

# --- anthropic ---
# 키 발급: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-여기에키
# ANTHROPIC_MODEL=claude-haiku-4-5
